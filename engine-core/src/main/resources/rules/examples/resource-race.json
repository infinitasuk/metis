{
  "languageVersion":1,"id":"resource-race","revision":"1",
  "modules":{"core":"1"},
  "limits":{"maxInstructions":1000,"maxCollectionSize":32,"maxCallDepth":8},
  "state":{
    "target":{"type":"integer","initial":5,"visibility":"PUBLIC"},
    "boostCost":{"type":"integer","initial":1,"visibility":"PUBLIC"}
  },
  "entities":{
    "counter":{"ownership":"PLAYER",
      "attributes":{"score":{"type":"integer","initial":0,"visibility":"PUBLIC"}},
      "resources":{"energy":{"initial":2,"minimum":0,"maximum":20,"visibility":"PUBLIC"}}}
  },
  "events":{"progress":{"visibility":"PUBLIC","fields":{"player":"player","score":"integer"}}},
  "setup":"prepare",
  "procedures":{
    "prepare":{"parameters":{},"steps":[
      {"op":"core.forEach","source":{"var":"players"},"as":"participant","maxItems":4,"steps":[
        {"op":"core.createEntity","type":"counter","id":{"op":"id","args":[{"var":"participant"}]},"owner":{"var":"participant"},"attributes":{},"resources":{},"as":"created"}
      ]}
    ]},
    "collect":{"parameters":{"actor":"player","counter":"entity:counter"},"steps":[
      {"op":"core.setAttribute","entity":{"var":"counter"},"field":"score","value":{"op":"add","args":[{"get":{"entity":{"var":"counter"},"field":"score"}},1]}},
      {"op":"core.call","procedure":"finish","args":{"actor":{"var":"actor"},"counter":{"var":"counter"}}}
    ]},
    "boost":{"parameters":{"actor":"player","counter":"entity:counter"},"steps":[
      {"op":"core.modifyResource","entity":{"var":"counter"},"resource":"energy","delta":{"op":"sub","args":[0,{"state":"boostCost"}]}},
      {"op":"core.setAttribute","entity":{"var":"counter"},"field":"score","value":{"op":"add","args":[{"get":{"entity":{"var":"counter"},"field":"score"}},2]}},
      {"op":"core.call","procedure":"finish","args":{"actor":{"var":"actor"},"counter":{"var":"counter"}}}
    ]},
    "finish":{"parameters":{"actor":"player","counter":"entity:counter"},"steps":[
      {"op":"core.emit","event":"progress","values":{"player":{"var":"actor"},"score":{"get":{"entity":{"var":"counter"},"field":"score"}}}},
      {"op":"core.if","condition":{"op":"gte","args":[{"get":{"entity":{"var":"counter"},"field":"score"}},{"state":"target"}]},
       "then":[{"op":"core.endGame","outcome":"victory","winners":{"list":{"elementType":"player","items":[{"var":"actor"}]}}}],"else":[]}
    ]}
  },
  "actions":{
    "collect":{"parameters":{"counter":"entity:counter"},
      "availableWhen":{"op":"eq","args":[{"owner":{"var":"counter"}},{"var":"actor"}]},
      "procedure":"collect","args":{"actor":{"var":"actor"},"counter":{"var":"counter"}}},
    "boost":{"parameters":{"counter":"entity:counter"},
      "availableWhen":{"op":"and","args":[
        {"op":"eq","args":[{"owner":{"var":"counter"}},{"var":"actor"}]},
        {"op":"gte","args":[{"resource":{"entity":{"var":"counter"},"field":"energy"}},{"state":"boostCost"}]}]},
      "procedure":"boost","args":{"actor":{"var":"actor"},"counter":{"var":"counter"}}}
  },
  "flow":{"initial":"turn","roundStart":"turn","phases":{
    "turn":{"controller":"ALTERNATING_PLAYERS","groupSize":1,"steps":[{"id":"act","actions":["collect","boost"],"minimum":1,"maximum":1}],"next":"turn"}
  }}
}
