{
 "languageVersion":1,"id":"dice-duel","revision":"1",
 "modules":{"core":"1","dice":"1","cards":"1","resources":"1","effects":"1","queues":"1"},
 "limits":{"maxInstructions":5000,"maxCollectionSize":64,"maxCallDepth":8,"maxWindowDepth":4},
 "dice":{"attack":{"maxRerolls":1,"faces":[{"weight":1,"value":0,"symbols":["hit","hit"]},{"weight":1,"value":0,"symbols":["critical"]}]}},
 "resultTables":{"damage":{"symbols":{"hit":1,"critical":2},"valueMultiplier":1,"unmapped":"ERROR"}},
 "decks":{"tactics":{"cards":["focus","supply","focus"],"shuffle":true,"exhaustion":"RESHUFFLE","discardVisibility":"PUBLIC"}},
 "effects":{"focus":{"duration":"ACTIVATION","stacking":"MAX","maximumStacks":2,"visibility":"PUBLIC"}},
 "state":{
  "orders":{"type":{"list":"string"},"initial":["focus","guard"],"visibility":"PUBLIC"},
  "guardPolicy":{"type":"string","initial":"halve","visibility":"PUBLIC"},
  "roll":{"type":"string","initial":"","visibility":"PUBLIC"},"damage":{"type":"integer","initial":0,"visibility":"PUBLIC"}
 },
 "entities":{"fighter":{"ownership":"PLAYER","attributes":{
  "orders":{"type":{"list":"string"},"initial":[],"visibility":"OWNER"},"capacity":{"type":"integer","initial":2,"visibility":"PUBLIC"},
  "deck":{"type":"string","initial":"","visibility":"OWNER"},"hand":{"type":"string","initial":"","visibility":"OWNER"}
 },"resources":{
  "health":{"initial":3,"minimum":0,"maximum":3,"visibility":"PUBLIC"},
  "guardReady":{"initial":1,"minimum":0,"maximum":1,"visibility":"PUBLIC"},"guardExhausted":{"initial":0,"minimum":0,"maximum":1,"visibility":"PUBLIC"},
  "rerollReady":{"initial":1,"minimum":0,"maximum":2,"visibility":"PUBLIC"},"rerollSpent":{"initial":0,"minimum":0,"maximum":2,"visibility":"PUBLIC"}
 }}},
 "events":{},"setup":"prepare",
 "procedures":{
  "prepare":{"parameters":{},"steps":[{"op":"core.forEach","source":{"var":"players"},"as":"p","maxItems":4,"steps":[
   {"op":"core.createEntity","type":"fighter","id":{"op":"id","args":[{"var":"p"}]},"owner":{"var":"p"},"attributes":{},"resources":{},"as":"fighter"},
   {"op":"cards.create","args":{"deck":"tactics","owner":{"var":"p"},"visibility":"SERVER"},"as":"deck"},
   {"op":"cards.hand","args":{"owner":{"var":"p"},"visibility":"OWNER"},"as":"hand"},
   {"op":"cards.draw","args":{"deck":{"var":"deck"},"to":{"var":"hand"},"count":1},"as":"drawn"},
   {"op":"core.setAttribute","entity":{"var":"fighter"},"field":"deck","value":{"var":"deck"}},
   {"op":"core.setAttribute","entity":{"var":"fighter"},"field":"hand","value":{"var":"hand"}}
  ]}]},
  "plan":{"parameters":{"fighter":"entity:fighter","orders":{"list":"string"}},"steps":[
   {"op":"queues.plan","args":{"entity":{"var":"fighter"},"field":"orders","capacity":{"get":{"entity":{"var":"fighter"},"field":"capacity"}},"orders":{"var":"orders"},"allowed":{"state":"orders"}}}
  ]},
  "commit":{"parameters":{},"steps":[{"op":"core.forEach","source":{"entities":"fighter"},"as":"fighter","maxItems":4,"steps":[{"op":"queues.commit","args":{"entity":{"var":"fighter"},"field":"orders"}}]}]},
  "attack":{"parameters":{"actor":"player","fighter":"entity:fighter","target":"entity:fighter"},"steps":[
   {"op":"queues.reveal","args":{"entity":{"var":"fighter"},"field":"orders"},"as":"order"},
   {"op":"core.if","condition":{"op":"eq","args":[{"var":"order"},"focus"]},"then":[{"op":"effects.apply","args":{"entity":{"var":"fighter"},"key":"focus","value":1},"as":"focus"}],"else":[]},
   {"op":"core.window","window":"playCard","args":{"actor":{"var":"actor"},"fighter":{"var":"fighter"}}},
   {"op":"dice.roll","args":{"dice":{"list":{"elementType":"string","items":["attack","attack"]}},"owner":{"var":"actor"},"visibility":"PUBLIC"},"as":"roll"},
   {"op":"core.if","condition":{"op":"gt","args":[{"query":{"op":"effects.total","args":{"entity":{"var":"fighter"},"key":"focus"}}},0]},"then":[{"op":"dice.add","args":{"roll":{"var":"roll"},"dice":{"list":{"elementType":"string","items":["attack"]}}}}],"else":[]},
   {"op":"core.setState","field":"roll","value":{"var":"roll"}},
   {"op":"core.window","window":"modify","args":{"actor":{"var":"actor"},"fighter":{"var":"fighter"},"roll":{"var":"roll"}}},
   {"op":"core.setState","field":"damage","value":{"query":{"op":"dice.resolve","args":{"roll":{"var":"roll"},"table":"damage"}}}},
   {"op":"core.window","window":"defend","args":{"target":{"var":"target"},"roll":{"var":"roll"}}},
   {"op":"core.if","condition":{"op":"gt","args":[{"state":"damage"},{"resource":{"entity":{"var":"target"},"field":"health"}}]},"then":[{"op":"core.setState","field":"damage","value":{"resource":{"entity":{"var":"target"},"field":"health"}}}],"else":[]},
   {"op":"core.modifyResource","entity":{"var":"target"},"resource":"health","delta":{"op":"sub","args":[0,{"state":"damage"}]}},
   {"op":"core.if","condition":{"op":"eq","args":[{"resource":{"entity":{"var":"target"},"field":"health"}},0]},"then":[{"op":"core.endGame","outcome":"victory","winners":{"list":{"elementType":"player","items":[{"var":"actor"}]}}}],"else":[]}
  ]},
  "playCard":{"parameters":{"actor":"player","fighter":"entity:fighter"},"steps":[
   {"op":"core.choose","player":{"var":"actor"},"options":{"query":{"op":"cards.pile","args":{"pile":{"get":{"entity":{"var":"fighter"},"field":"hand"}}}}},"as":"card","visibility":"OWNER"},
   {"op":"cards.discard","args":{"cards":{"list":{"elementType":"string","items":[{"var":"card"}]}},"from":{"get":{"entity":{"var":"fighter"},"field":"hand"}},"deck":{"get":{"entity":{"var":"fighter"},"field":"deck"}}}},
   {"op":"core.if","condition":{"op":"eq","args":[{"query":{"op":"cards.type","args":{"card":{"var":"card"}}}},"focus"]},"then":[{"op":"effects.apply","args":{"entity":{"var":"fighter"},"key":"focus","value":1},"as":"focus"}],"else":[{"op":"core.modifyResource","entity":{"var":"fighter"},"resource":"rerollReady","delta":1}]}
  ]},
  "reroll":{"parameters":{"actor":"player","fighter":"entity:fighter","roll":"string"},"steps":[
   {"op":"core.choose","player":{"var":"actor"},"options":{"query":{"op":"dice.indices","args":{"roll":{"var":"roll"}}}},"as":"index","visibility":"PUBLIC"},
   {"op":"resources.transfer","args":{"from":{"var":"fighter"},"fromResource":"rerollReady","to":{"var":"fighter"},"toResource":"rerollSpent","amount":1}},
   {"op":"dice.reroll","args":{"roll":{"var":"roll"},"indices":{"list":{"elementType":"integer","items":[{"var":"index"}]}},"allowed":{"query":{"op":"dice.indices","args":{"roll":{"var":"roll"}}}},"maximum":1}}
  ]},
  "guard":{"parameters":{"target":"entity:fighter","roll":"string"},"steps":[
   {"op":"resources.once","args":{"entity":{"var":"target"},"key":"guard","period":"ROUND"}},
   {"op":"resources.transfer","args":{"from":{"var":"target"},"fromResource":"guardReady","to":{"var":"target"},"toResource":"guardExhausted","amount":1}},
   {"op":"core.if","condition":{"op":"eq","args":[{"state":"guardPolicy"},"halve"]},"then":[{"op":"core.setState","field":"damage","value":{"op":"ceil","args":[{"op":"div","args":[{"state":"damage"},2]}]}}],"else":[
    {"op":"core.if","condition":{"op":"contains","args":[{"query":{"op":"dice.symbols","args":{"roll":{"var":"roll"}}}},"hit"]},"then":[{"op":"dice.cancel","args":{"roll":{"var":"roll"},"symbols":{"list":{"elementType":"string","items":["hit"]}},"maximum":1}}],"else":[]},
    {"op":"core.setState","field":"damage","value":{"query":{"op":"dice.resolve","args":{"roll":{"var":"roll"},"table":"damage"}}}}
   ]}
  ]},
  "refresh":{"parameters":{},"steps":[{"op":"core.forEach","source":{"entities":"fighter"},"as":"fighter","maxItems":4,"steps":[
   {"op":"resources.transfer","args":{"from":{"var":"fighter"},"fromResource":"guardExhausted","to":{"var":"fighter"},"toResource":"guardReady","amount":{"resource":{"entity":{"var":"fighter"},"field":"guardExhausted"}}}}
  ]}]}
 },
 "windows":{
  "playCard":{"parameters":{"actor":"player","fighter":"entity:fighter"},"responders":{"list":{"elementType":"player","items":[{"var":"actor"}]}},"maxResponders":1,"allowPass":true,"visibility":"OWNER","choices":[{"id":"play","when":{"op":"gt","args":[{"op":"count","args":[{"query":{"op":"cards.pile","args":{"pile":{"get":{"entity":{"var":"fighter"},"field":"hand"}}}}}]},0]},"procedure":"playCard","args":{"actor":{"var":"actor"},"fighter":{"var":"fighter"}}}]},
  "modify":{"parameters":{"actor":"player","fighter":"entity:fighter","roll":"string"},"responders":{"list":{"elementType":"player","items":[{"var":"actor"}]}},"maxResponders":1,"allowPass":true,"visibility":"OWNER","choices":[{"id":"reroll","when":{"op":"gt","args":[{"resource":{"entity":{"var":"fighter"},"field":"rerollReady"}},0]},"procedure":"reroll","args":{"actor":{"var":"actor"},"fighter":{"var":"fighter"},"roll":{"var":"roll"}}}]},
  "defend":{"parameters":{"target":"entity:fighter","roll":"string"},"responders":{"list":{"elementType":"player","items":[{"owner":{"var":"target"}}]}},"maxResponders":1,"allowPass":true,"visibility":"OWNER","choices":[{"id":"guard","when":{"op":"gt","args":[{"resource":{"entity":{"var":"target"},"field":"guardReady"}},0]},"procedure":"guard","args":{"target":{"var":"target"},"roll":{"var":"roll"}}}]}
 },
 "actions":{
  "plan":{"parameters":{"fighter":"entity:fighter","orders":{"list":"string"}},"availableWhen":{"op":"eq","args":[{"owner":{"var":"fighter"}},{"var":"actor"}]},"procedure":"plan","args":{"fighter":{"var":"fighter"},"orders":{"var":"orders"}}},
  "attack":{"parameters":{"fighter":"entity:fighter","target":"entity:fighter"},"availableWhen":{"op":"and","args":[{"op":"eq","args":[{"owner":{"var":"fighter"}},{"var":"actor"}]},{"op":"ne","args":[{"owner":{"var":"target"}},{"var":"actor"}]},{"op":"gt","args":[{"resource":{"entity":{"var":"fighter"},"field":"health"}},0]}]},"procedure":"attack","args":{"actor":{"var":"actor"},"fighter":{"var":"fighter"},"target":{"var":"target"}}}
 },
 "flow":{"initial":"planning","roundStart":"planning","phases":{
  "planning":{"controller":"SIMULTANEOUS","groupSize":1,"steps":[{"id":"plan","actions":["plan"],"minimum":1,"maximum":1}],"next":"battle"},
  "battle":{"controller":"ALTERNATING_PLAYERS","groupSize":1,"onEnter":"commit","steps":[{"id":"attack","actions":["attack"],"minimum":1,"maximum":1}],"next":"refresh"},
  "refresh":{"controller":"AUTOMATIC","groupSize":1,"onEnter":"refresh","steps":[],"next":"planning"}
 }}
}
