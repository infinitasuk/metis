{
  "languageVersion":1,"id":"hidden-grid-cpu","revision":"1",
  "modules":{"core":"1"},
  "limits":{"maxInstructions":1000,"maxCollectionSize":32,"maxCallDepth":8},
  "state":{"cells":{"type":{"list":"string"},"initial":["A1","A2","A3","B1","B2","B3","C1","C2","C3"],"visibility":"PUBLIC"}},
  "entities":{"target":{"ownership":"PLAYER","attributes":{
    "cell":{"type":"string","initial":"","visibility":"OWNER"},
    "hit":{"type":"boolean","initial":false,"visibility":"PUBLIC"},
    "guesses":{"type":{"list":"string"},"initial":[],"visibility":"OWNER"}
  },"resources":{}}},
  "events":{"guess":{"visibility":"PUBLIC","fields":{"player":"player","cell":"string","hit":"boolean"}}},
  "setup":"prepare",
  "procedures":{
    "prepare":{"parameters":{},"steps":[
      {"op":"core.forEach","source":{"var":"players"},"as":"participant","maxItems":4,"steps":[
        {"op":"core.choose","player":{"var":"participant"},"options":{"state":"cells"},"as":"cell","visibility":"OWNER"},
        {"op":"core.createEntity","type":"target","id":{"op":"id","args":[{"var":"participant"}]},"owner":{"var":"participant"},"attributes":{"cell":{"var":"cell"}},"resources":{},"as":"created"}
      ]}
    ]},
    "guess":{"parameters":{"actor":"player","ownTarget":"entity:target","cell":"string"},"steps":[
      {"op":"core.setAttribute","entity":{"var":"ownTarget"},"field":"guesses","value":{"op":"append","args":[{"get":{"entity":{"var":"ownTarget"},"field":"guesses"}},{"var":"cell"}]}},
      {"op":"core.let","name":"matches","value":{"filter":{"source":{"entities":"target"},"as":"candidate","where":{"op":"and","args":[
        {"op":"ne","args":[{"owner":{"var":"candidate"}},{"var":"actor"}]},
        {"op":"eq","args":[{"get":{"entity":{"var":"candidate"},"field":"cell"}},{"var":"cell"}]}]}}}},
      {"op":"core.forEach","source":{"var":"matches"},"as":"matched","maxItems":4,"steps":[
        {"op":"core.setAttribute","entity":{"var":"matched"},"field":"hit","value":true}
      ]},
      {"op":"core.emit","event":"guess","values":{"player":{"var":"actor"},"cell":{"var":"cell"},"hit":{"op":"gt","args":[{"op":"count","args":[{"var":"matches"}]},0]}}},
      {"op":"core.if","condition":{"op":"eq","args":[{"op":"count","args":[{"filter":{"source":{"entities":"target"},"as":"candidate","where":{"op":"and","args":[
        {"op":"ne","args":[{"owner":{"var":"candidate"}},{"var":"actor"}]},
        {"op":"not","args":[{"get":{"entity":{"var":"candidate"},"field":"hit"}}]}
      ]}}}]},0]},"then":[{"op":"core.endGame","outcome":"victory","winners":{"list":{"elementType":"player","items":[{"var":"actor"}]}}}],"else":[]}
    ]}
  },
  "actions":{"guess":{"parameters":{"ownTarget":"entity:target","cell":"string"},"availableWhen":{"op":"and","args":[
    {"op":"eq","args":[{"owner":{"var":"ownTarget"}},{"var":"actor"}]},
    {"op":"contains","args":[{"state":"cells"},{"var":"cell"}]},
    {"op":"not","args":[{"op":"contains","args":[{"get":{"entity":{"var":"ownTarget"},"field":"guesses"}},{"var":"cell"}]}]}
  ]},"procedure":"guess","args":{"actor":{"var":"actor"},"ownTarget":{"var":"ownTarget"},"cell":{"var":"cell"}},"choices":{"cell":{"state":"cells"},"ownTarget":{"filter":{"source":{"entities":"target"},"as":"e","where":{"op":"eq","args":[{"owner":{"var":"e"}},{"var":"actor"}]}}}}}},
  "flow":{"initial":"turn","roundStart":"turn","phases":{
    "turn":{"controller":"ALTERNATING_PLAYERS","groupSize":1,"steps":[{"id":"guess","actions":["guess"],"minimum":1,"maximum":1}],"next":"turn"}
  }}
}
