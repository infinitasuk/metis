{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://metis.local/schemas/rules/language-v1",
  "title":"METIS executable rules language v1 (compiler contract)",
  "type":"object","additionalProperties":false,
  "required":["languageVersion","id","revision","modules","limits","state","entities","events","procedures","actions","flow","setup"],
  "properties":{
    "languageVersion":{"const":1},"id":{"$ref":"#/$defs/id"},"revision":{"type":"string","minLength":1,"maxLength":64},
    "modules":{"type":"object","minProperties":1,"maxProperties":32,"propertyNames":{"pattern":"^[a-z][a-z0-9_-]{0,63}$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":64}},
    "limits":{"type":"object","additionalProperties":false,"required":["maxInstructions","maxCollectionSize","maxCallDepth"],"properties":{
      "maxInstructions":{"type":"integer","minimum":1,"maximum":100000},"maxCollectionSize":{"type":"integer","minimum":1,"maximum":1024},"maxCallDepth":{"type":"integer","minimum":1,"maximum":32},"maxWindowDepth":{"type":"integer","minimum":1,"maximum":16}}},
    "state":{"$ref":"#/$defs/fields"},
    "entities":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["ownership","attributes","resources"],"properties":{
        "ownership":{"enum":["PLAYER","NONE"]},"attributes":{"$ref":"#/$defs/fields"},
        "resources":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/resource"}}}}},
    "events":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["visibility","fields"],"properties":{"visibility":{"$ref":"#/$defs/audience"},"fields":{"$ref":"#/$defs/typeMap"}}}},
    "procedures":{"type":"object","minProperties":1,"maxProperties":256,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["parameters","steps"],"properties":{"parameters":{"$ref":"#/$defs/typeMap"},"steps":{"$ref":"#/$defs/instructions"}}}},
    "actions":{"type":"object","minProperties":1,"maxProperties":256,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["parameters","availableWhen","procedure","args"],"properties":{
        "parameters":{"$ref":"#/$defs/typeMap"},"availableWhen":{"$ref":"#/$defs/expression"},"procedure":{"$ref":"#/$defs/id"},"args":{"$ref":"#/$defs/expressions"},
         "choices":{"$ref":"#/$defs/expressions"},"priority":{"type":"integer","minimum":-10000,"maximum":10000},"preview":{"enum":["MOVEMENT"]},
         "maneuver":{"type":"object","additionalProperties":false,"required":["entity","speed","yaw","side","chart"],"properties":{"entity":{"$ref":"#/$defs/id"},"speed":{"$ref":"#/$defs/id"},"yaw":{"$ref":"#/$defs/id"},"side":{"$ref":"#/$defs/id"},"chart":{"$ref":"#/$defs/expression"}}}}}},
    "setup":{"$ref":"#/$defs/id"},
    "space":{"type":"object","additionalProperties":false,"required":["boards","bodies","movements","zones"],"properties":{
      "boards":{"type":"object","maxProperties":16,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["model","width","height","unit","metric","cornerCutting","touchingAllowed","tolerance"],"properties":{
          "model":{"enum":["GRID","CONTINUOUS"]},"width":{"$ref":"#/$defs/positiveSize"},"height":{"$ref":"#/$defs/positiveSize"},"unit":{"$ref":"#/$defs/id"},
          "metric":{"enum":["MANHATTAN","CHEBYSHEV","EUCLIDEAN"]},"cornerCutting":{"type":"boolean"},"touchingAllowed":{"type":"boolean"},"tolerance":{"type":"number","minimum":0.000000001,"maximum":0.001}}}},
      "bodies":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["board","x","y","facing","placed","solid","opaque","shape","radius","width","height"],"properties":{
          "board":{"$ref":"#/$defs/id"},"x":{"$ref":"#/$defs/id"},"y":{"$ref":"#/$defs/id"},"facing":{"$ref":"#/$defs/id"},"placed":{"$ref":"#/$defs/id"},"solid":{"$ref":"#/$defs/id"},"opaque":{"$ref":"#/$defs/id"},
          "shape":{"enum":["POINT","CIRCLE","RECTANGLE"]},"radius":{"$ref":"#/$defs/size"},"width":{"$ref":"#/$defs/size"},"height":{"$ref":"#/$defs/size"}}}},
      "movements":{"type":"object","maxProperties":64,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["traversal","allowance","maximumTurn","collisions","ownerOnly"],"properties":{
          "traversal":{"enum":["SWEPT","DESTINATION"]},"allowance":{"$ref":"#/$defs/id"},"maximumTurn":{"type":"number","minimum":0,"maximum":180},"collisions":{"type":"boolean"},"ownerOnly":{"type":"boolean"}}}},
      "zones":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["board","ownerSeat","x","y","width","height"],"properties":{"board":{"$ref":"#/$defs/id"},"ownerSeat":{"type":"integer","minimum":-1,"maximum":1023},"x":{"$ref":"#/$defs/size"},"y":{"$ref":"#/$defs/size"},"width":{"$ref":"#/$defs/positiveSize"},"height":{"$ref":"#/$defs/positiveSize"}}}}
    }},
    "scenario":{"type":"object","additionalProperties":false,"required":["rosters","damage"],"properties":{
      "rosters":{"type":"object","maxProperties":64,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["entityType","points","budget","minimum","maximum","unique","faction","factions"],"properties":{
          "entityType":{"$ref":"#/$defs/id"},"points":{"$ref":"#/$defs/id"},"budget":{"type":"integer","minimum":0,"maximum":9223372036854775807},"minimum":{"type":"integer","minimum":0,"maximum":1024},"maximum":{"type":"integer","minimum":1,"maximum":1024},
          "unique":{"type":"string","maxLength":64},"faction":{"type":"string","maxLength":64},"factions":{"type":"array","maxItems":128,"items":{"type":"string","maxLength":128}}}}},
      "damage":{"type":"object","maxProperties":64,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"type":"object","additionalProperties":false,
        "required":["entityType","health","absorbers","capAtRemaining","onZero","marker"],"properties":{
          "entityType":{"$ref":"#/$defs/id"},"health":{"$ref":"#/$defs/id"},"absorbers":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/id"}},"capAtRemaining":{"type":"boolean"},"onZero":{"enum":["KEEP","REMOVE","MARK"]},"marker":{"type":"string","maxLength":64}}}}
    }},
    "dice":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["faces","maxRerolls"],"properties":{
        "maxRerolls":{"type":"integer","minimum":0,"maximum":16},"faces":{"type":"array","minItems":1,"maxItems":256,"items":{
          "type":"object","additionalProperties":false,"required":["weight","value","symbols"],"properties":{
            "weight":{"type":"integer","minimum":1,"maximum":1000000},"value":{"$ref":"#/$defs/integer"},"symbols":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/id"}}}}}}}},
    "resultTables":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["symbols","valueMultiplier","unmapped"],"properties":{
        "symbols":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/integer"}},
        "valueMultiplier":{"$ref":"#/$defs/integer"},"unmapped":{"enum":["ERROR","IGNORE"]}}}},
    "decks":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["cards","shuffle","exhaustion","discardVisibility"],"properties":{
        "cards":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/id"}},"shuffle":{"type":"boolean"},"exhaustion":{"enum":["REJECT","PARTIAL","RESHUFFLE"]},"discardVisibility":{"$ref":"#/$defs/audience"}}}},
    "effects":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["duration","stacking","maximumStacks","visibility"],"properties":{
        "duration":{"enum":["ACTION","ACTIVATION","ROUND","PERSISTENT"]},"stacking":{"enum":["ADD","MAX","REPLACE"]},"maximumStacks":{"type":"integer","minimum":1,"maximum":1024},"visibility":{"$ref":"#/$defs/audience"}}}},
    "windows":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["parameters","responders","maxResponders","allowPass","visibility","choices"],"properties":{
        "parameters":{"$ref":"#/$defs/typeMap"},"responders":{"$ref":"#/$defs/expression"},"maxResponders":{"type":"integer","minimum":1,"maximum":1024},
        "allowPass":{"type":"boolean"},"visibility":{"enum":["PUBLIC","OWNER"]},
        "choices":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","when","procedure","args"],"properties":{
          "id":{"$ref":"#/$defs/id"},"when":{"$ref":"#/$defs/expression"},"procedure":{"$ref":"#/$defs/id"},"args":{"$ref":"#/$defs/expressions"}}}}}}},
    "flow":{"type":"object","additionalProperties":false,"required":["initial","roundStart","phases"],"properties":{
      "initial":{"$ref":"#/$defs/id"},"roundStart":{"$ref":"#/$defs/id"},
      "phases":{"type":"object","minProperties":1,"maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
        "type":"object","additionalProperties":false,"required":["controller","groupSize","steps","next"],"properties":{
          "controller":{"enum":["ALTERNATING_PLAYERS","ALTERNATING_ENTITIES","PLAYER_PHASE","SIMULTANEOUS","MANUAL","AUTOMATIC"]},
          "groupSize":{"type":"integer","minimum":1,"maximum":1024},"entities":{"$ref":"#/$defs/expression"},"entityParameter":{"$ref":"#/$defs/id"},"onEnter":{"$ref":"#/$defs/id"},"next":{"$ref":"#/$defs/id"},
          "steps":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","actions","minimum","maximum"],"properties":{
            "id":{"$ref":"#/$defs/id"},"actions":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
            "minimum":{"type":"integer","minimum":0,"maximum":100000},"maximum":{"type":"integer","minimum":1,"maximum":100000}}}}}}}}}
  },
  "$defs":{
    "size":{"type":"number","minimum":0,"maximum":1000000000},
    "positiveSize":{"type":"number","exclusiveMinimum":0,"maximum":1000000000},
    "id":{"type":"string","pattern":"^[a-z][a-zA-Z0-9_-]{0,63}$"},
    "audience":{"enum":["PUBLIC","OWNER","SERVER"]},
    "integer":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},
    "type":{"oneOf":[{"enum":["integer","decimal","boolean","string","player"]},{"type":"string","pattern":"^entity:[a-z][a-zA-Z0-9_-]{0,63}$"},
      {"type":"object","additionalProperties":false,"required":["list"],"properties":{"list":{"$ref":"#/$defs/type"}}}]},
    "typeMap":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/type"}},
    "fields":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{
      "type":"object","additionalProperties":false,"required":["type","initial","visibility"],"properties":{"type":{"$ref":"#/$defs/type"},"initial":{},"visibility":{"$ref":"#/$defs/audience"}}}},
    "resource":{"type":"object","additionalProperties":false,"required":["initial","minimum","maximum","visibility"],"properties":{
      "initial":{"$ref":"#/$defs/integer"},"minimum":{"$ref":"#/$defs/integer"},"maximum":{"$ref":"#/$defs/integer"},"visibility":{"$ref":"#/$defs/audience"}}},
    "instructions":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/instruction"}},
    "instruction":{"type":"object","maxProperties":16,"required":["op"],"properties":{"op":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}\\.[a-zA-Z][a-zA-Z0-9]*$"}},
      "$comment":"Exact fields and dynamic argument types are validated against the pinned operation registry by the compiler."},
    "expressions":{"type":"object","maxProperties":128,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/expression"}},
    "expression":{"oneOf":[
      {"type":["number","boolean"]},{"type":"string","maxLength":4096},
      {"type":"object","additionalProperties":false,"required":["var"],"properties":{"var":{"$ref":"#/$defs/id"}}},
      {"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"$ref":"#/$defs/id"}}},
      {"type":"object","additionalProperties":false,"required":["entities"],"properties":{"entities":{"$ref":"#/$defs/id"}}},
      {"type":"object","additionalProperties":false,"required":["owner"],"properties":{"owner":{"$ref":"#/$defs/expression"}}},
      {"type":"object","additionalProperties":false,"required":["get"],"properties":{"get":{"$ref":"#/$defs/fieldRead"}}},
      {"type":"object","additionalProperties":false,"required":["resource"],"properties":{"resource":{"$ref":"#/$defs/fieldRead"}}},
      {"type":"object","additionalProperties":false,"required":["query"],"properties":{"query":{"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"type":"string"},"args":{"$ref":"#/$defs/expressions"}}}}},
      {"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"type":"string"},"args":{"type":"array","minItems":1,"maxItems":1024,"items":{"$ref":"#/$defs/expression"}}}},
      {"type":"object","additionalProperties":false,"required":["list"],"properties":{"list":{"type":"object","additionalProperties":false,"required":["elementType","items"],"properties":{
        "elementType":{"$ref":"#/$defs/type"},"items":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/expression"}}}}}},
      {"type":"object","additionalProperties":false,"required":["filter"],"properties":{"filter":{"type":"object","additionalProperties":false,"required":["source","as","where"],"properties":{
        "source":{"$ref":"#/$defs/expression"},"as":{"$ref":"#/$defs/id"},"where":{"$ref":"#/$defs/expression"}}}}},
      {"type":"object","additionalProperties":false,"required":["map"],"properties":{"map":{"type":"object","additionalProperties":false,"required":["source","as","value"],"properties":{
        "source":{"$ref":"#/$defs/expression"},"as":{"$ref":"#/$defs/id"},"value":{"$ref":"#/$defs/expression"}}}}}
    ]},
    "fieldRead":{"type":"object","additionalProperties":false,"required":["entity","field"],"properties":{"entity":{"$ref":"#/$defs/expression"},"field":{"$ref":"#/$defs/id"}}}
  }
}
